    "ssh.error.algorithm": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se vyjednat kompatibilní SSH algoritmy. iOS verze NetKitu podporuje hostitelské klíče Ed25519 a ECDSA; RSA nepodporuje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not negotiate compatible SSH algorithms. NetKit for iOS supports Ed25519 and ECDSA host keys; RSA is unsupported."
          }
        }
      }
    },
    "ssh.error.unsupported_credential": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodporovaný přihlašovací klíč. iOS verze NetKitu podporuje přihlašování klíčem pouze s Ed25519 vygenerovaným v aplikaci."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported authentication key. NetKit for iOS supports key authentication only with Ed25519 keys generated in the app."
          }
        }
      }
    },
    "about.privacy": {
